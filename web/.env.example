# Google OAuth (Web Client)
VITE_GOOGLE_CLIENT_ID=seu-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_ID=seu-client-id.apps.googleusercontent.com

# Agenda do barbeiro Maycon (use "primary" para agenda principal do Gmail logado)
VITE_CALENDAR_MAYCON_ID=primary
CALENDAR_MAYCON_ID=primary

# Para vários barbeiros, use JSON:
# BARBEIROS_CALENDARS={"Maycon":"primary","João":"email@gmail.com"}

# Supabase (opcional — persistência em nuvem)
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-anon-key
