# Google OAuth (Web Client) — também usado pelas Netlify Functions
VITE_GOOGLE_CLIENT_ID=seu-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_ID=seu-client-id.apps.googleusercontent.com

# IDs ou e-mails das agendas no Google Calendar
# Use "primary" para a agenda principal da conta logada
VITE_CALENDAR_ELIZEU_ID=primary
VITE_CALENDAR_PAULO_ID=primary
CALENDAR_ELIZEU_ID=primary
CALENDAR_PAULO_ID=primary
